{
  "name": "animood-final",
  "private": true,
  "version": "1.0.0",
  "description": "AniMood — recommandations d'animés selon ton humeur",
  "author": "AniMood",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync:anime": "node scripts/sync_new_anime.mjs",
    "sync:titles": "node scripts/sync_alt_titles.mjs",
    "sync:moods": "node scripts/sync_new_moods.mjs",
    "sync:artists": "node scripts/sync_artists.mjs",
    "sync:weekly": "node --env-file=.env scripts/animood_sync.mjs --job=weekly",
    "electron:dev": "cross-env NODE_ENV=development concurrently -k \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build --mode electron && electron-builder --config electron-builder.yml",
    "electron:build:mac": "vite build --mode electron && electron-builder --mac --config electron-builder.yml",
    "electron:build:win": "vite build --mode electron && electron-builder --win --config electron-builder.yml",
    "electron:build:store": "vite build --mode electron && electron-builder --win appx --config electron-builder.store.yml",
    "electron:build:linux": "vite build --mode electron && electron-builder --linux --config electron-builder.yml"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.2",
    "@tailwindcss/vite": "^4.2.4",
    "html2canvas": "^1.4.1",
    "node-fetch": "^3.3.2",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3",
    "electron-updater": "^6.3.9",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^8.0.3"
  }
}
